# Backend Environment Configuration

# Application Settings
APP_NAME="Empowering the Individual - Learning Support API"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Default is a local SQLite database file located in the backend folder
DATABASE_URL=sqlite:///./learning_platform.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM API Key (Keep empty to use predefined pedagogical fallback explanations)
# Example: GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=
LLM_PROVIDER=gemini

