# ==============================================================================
# IT22301 - Data Structures and Algorithms Intelligent Tutoring System
# Backend Environment Configuration Template
# ==============================================================================

# Core Application Settings
APP_NAME="IT22301 DSA Intelligent Tutoring System"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default: Local SQLite database
DATABASE_URL=sqlite:///./dsa_tutor.db
# Migration to PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/it22301_dsa

# CORS Security (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# External Integration: Google Gemini API (Personalized Socratic Tutoring)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to utilize structured rule-based pedagogical fallbacks
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# External Integration: Judge0 CE (Java Code Execution)
# Use a self-hosted instance (e.g. http://localhost:2358) or RapidAPI endpoint
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_TIMEOUT_SECONDS=10.0

